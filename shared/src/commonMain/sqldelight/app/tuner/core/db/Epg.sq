CREATE TABLE programme (
  source_id INTEGER NOT NULL,
  epg_key TEXT NOT NULL,
  start INTEGER NOT NULL,
  stop INTEGER NOT NULL,
  title TEXT NOT NULL,
  description TEXT,
  category TEXT,
  icon TEXT,
  episode TEXT
);
CREATE INDEX programme_key_start ON programme(epg_key, start);
CREATE INDEX programme_source ON programme(source_id);
CREATE INDEX programme_start ON programme(start);

CREATE TABLE epg_channel (
  source_id INTEGER NOT NULL,
  epg_key TEXT NOT NULL,
  name_norm TEXT NOT NULL
);
CREATE INDEX epg_channel_key ON epg_channel(epg_key);

deleteProgrammes:
DELETE FROM programme WHERE source_id = ?;

deleteEpgChannels:
DELETE FROM epg_channel WHERE source_id = ?;

promoteProgrammes:
UPDATE programme SET source_id = :sourceId WHERE source_id = -:sourceId;

promoteEpgChannels:
UPDATE epg_channel SET source_id = :sourceId WHERE source_id = -:sourceId;

insertProgramme:
INSERT INTO programme(source_id, epg_key, start, stop, title, description, category, icon, episode)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertEpgChannel:
INSERT INTO epg_channel(source_id, epg_key, name_norm) VALUES (?, ?, ?);

allEpgChannels:
SELECT DISTINCT epg_key, name_norm FROM epg_channel;

distinctProgrammeKeys:
SELECT DISTINCT epg_key FROM programme;

programmesInWindow:
SELECT * FROM programme
WHERE epg_key IN ? AND stop > ? AND start < ?
ORDER BY epg_key, start;

currentProgramme:
SELECT * FROM programme WHERE epg_key = ? AND start <= :now AND stop > :now ORDER BY start DESC LIMIT 1;

nextProgrammes:
SELECT * FROM programme WHERE epg_key = ? AND stop > :now ORDER BY start LIMIT :limit;

searchProgrammes:
-- Programmes on air in [from, to): the start index bounds the scan (programmes are
-- assumed to run under a day), and each hit picks one enabled channel via channel_epg
-- instead of joining every channel that shares the guide id.
SELECT p.source_id, p.epg_key, p.start, p.stop, p.title, p.description, p.category, p.icon, p.episode,
       ch.id AS channel_id, ch.name AS channel_name, ch.logo AS channel_logo
FROM (
  SELECT pr.*, (
    SELECT c.id FROM channel c JOIN source s ON s.id = c.source_id AND s.enabled = 1
    WHERE c.epg_key = pr.epg_key LIMIT 1
  ) AS cid
  FROM programme pr
  WHERE pr.start > :from - 86400000 AND pr.start < :to AND pr.stop > :from AND pr.title LIKE ('%' || :query || '%')
) p
JOIN channel ch ON ch.id = p.cid
GROUP BY p.epg_key, p.start
ORDER BY p.start
LIMIT :limit;

pruneProgrammes:
DELETE FROM programme WHERE stop < ?;

programmeCount:
SELECT COUNT(*) FROM programme WHERE source_id = ?;
