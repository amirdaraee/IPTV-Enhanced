CREATE TABLE source (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  type TEXT NOT NULL,
  url TEXT NOT NULL,
  username TEXT,
  password TEXT,
  epg_urls TEXT NOT NULL DEFAULT '',
  user_agent TEXT,
  epg_offset_minutes INTEGER NOT NULL DEFAULT 0,
  refresh_hours INTEGER NOT NULL DEFAULT 24,
  last_refreshed INTEGER,
  last_error TEXT,
  enabled INTEGER NOT NULL DEFAULT 1,
  position INTEGER NOT NULL DEFAULT 0,
  server_timezone TEXT,
  expires_at INTEGER,
  max_connections INTEGER,
  output_format TEXT,
  auto_epg_urls TEXT NOT NULL DEFAULT ''
);

selectAll:
SELECT * FROM source ORDER BY position, id;

selectEnabled:
SELECT * FROM source WHERE enabled = 1 ORDER BY position, id;

selectById:
SELECT * FROM source WHERE id = ?;

insert:
INSERT INTO source(name, type, url, username, password, epg_urls, user_agent, epg_offset_minutes, refresh_hours, enabled, position)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, (SELECT IFNULL(MAX(position), 0) + 1 FROM source));

lastInsertId:
SELECT last_insert_rowid();

update:
UPDATE source SET name = ?, url = ?, username = ?, password = ?, epg_urls = ?, user_agent = ?, epg_offset_minutes = ?, refresh_hours = ?, enabled = ?
WHERE id = ?;

markRefreshed:
UPDATE source SET last_refreshed = ?, last_error = NULL WHERE id = ?;

markError:
UPDATE source SET last_error = ? WHERE id = ?;

updateAccount:
UPDATE source SET server_timezone = ?, expires_at = ?, max_connections = ?, output_format = ? WHERE id = ?;

setAutoEpg:
UPDATE source SET auto_epg_urls = ? WHERE id = ?;

delete:
DELETE FROM source WHERE id = ?;

-- ---------- user data backup ----------

restore:
INSERT INTO source(name, type, url, username, password, epg_urls, user_agent, epg_offset_minutes, refresh_hours, enabled, position)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
